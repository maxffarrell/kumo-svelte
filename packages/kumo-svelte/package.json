{
  "name": "kumo-svelte",
  "version": "0.13.0",
  "description": "Svelte port of Cloudflare's Kumo UI library using bits-ui primitives.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxffarrell/kumo-svelte"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "kumo-svelte": "./dist/command-line/cli.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "ai",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./ai/component-registry.json": {
      "default": "./ai/component-registry.json"
    },
    "./registry/component-registry.json": "./ai/component-registry.json",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "svelte": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    }
  },
  "scripts": {
    "check": "svelte-kit sync && svelte-check-native --tsconfig ./tsconfig.json",
    "codegen:registry": "tsx scripts/component-registry.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "package": "svelte-package",
    "build:styles": "tsx scripts/build-package-css.ts",
    "build:docs": "pnpm codegen:registry && vite build",
    "build:package": "pnpm codegen:registry && pnpm check && pnpm package && pnpm build:styles && pnpm build:cli",
    "build:full": "pnpm build:package && vite build",
    "build": "pnpm build:docs",
    "deploy": "pnpm build:docs && wrangler deploy",
    "dev": "pnpm codegen:registry && vite dev",
    "preview": "vite preview",
    "test": "CI=true vitest run",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "pnpm check"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.60.1",
    "echarts": "^6.0.0",
    "svelte": "^5.56.3"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "bits-ui": "^2.19.0",
    "cnfast": "^0.1.0",
    "d3-geo": "^3.1.1",
    "esm-env": "^1.2.2",
    "phosphor-svelte": "^3.1.0",
    "shiki": "^4.4.3",
    "svelte-sonner": "^1.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "magic-string": "^1.2.2",
    "mdsx": "^0.0.7",
    "svelte": "^5.56.10",
    "svelte-check-native": "^0.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
