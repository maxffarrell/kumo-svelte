{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "module": "ESNext",
    "target": "ES2022",
    "types": [
      "svelte",
      "$app/types"
    ]
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte", "mdsx.config.js", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/command-line",
    "src/**/*.test.ts",
    "tests"
  ]
}
